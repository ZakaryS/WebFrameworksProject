
extends layout

block content
  .container
   .row
    .col-md-6.col-md-offset-3
     h1 Login
     form(action="/register" method="POST")
      .form-group
       label(for="email") Email
       input#email.form-control(type="email" name="email" required)
      .form-group
       label(for="username") Username
       input#email.form-control(type="text" name="username" required)
      .form-group
       label(for="password") Password
       input#password.form-control(type="password" name="password" required)
      //button.btn(type="submit") Register
      a.btn(href="/login") Register
      a.btn(href="/login") Back
