extends layout

block content
  .row.banner
   .col-12
    h1= title
  .row  
   each product in foods
    .col-12.col-md-4
     .card 
      .card-body
       h4 
        a(href="/product")= product.name 
       img.img-fluid(src=product.image ) 
       p= "Product Mass: " + product.mass + "g" 
       p= "Product Price: €" + product.cost 